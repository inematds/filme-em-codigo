  "legendas": [
    { "de": 0.3, "ate": 1.35, "texto": "O mel quase" },
    { "de": 1.35, "ate": 2.45, "texto": "nunca estraga." },
    { "de": 2.55, "ate": 3.85, "texto": "Numa tumba egípcia," },
    { "de": 3.85, "ate": 5.15, "texto": "doce após 3 mil anos." },
    { "de": 5.25, "ate": 6.1, "texto": "Lenda duvidosa." },
    { "de": 6.1, "ate": 6.95, "texto": "A química, não." },
    { "de": 7.05, "ate": 8.55, "texto": "Mel tem pouca água" },
    { "de": 8.55, "ate": 9.95, "texto": "e é ácido." },
    { "de": 10.05, "ate": 11.5, "texto": "A abelha põe enzima" },
    { "de": 11.5, "ate": 12.75, "texto": "e os germes não crescem." },
    { "de": 12.85, "ate": 13.8, "texto": "Bem fechado," },
    { "de": 13.8, "ate": 14.65, "texto": "o mel dura." }
